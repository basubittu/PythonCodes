{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Pytest and show output",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": [
                "-m",
                "pytest",
                "${workspaceFolder}\\.venv\\Pytest.py",
                "-q",
                "-s"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
